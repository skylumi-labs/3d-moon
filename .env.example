# Every build and dev-server variable, with its default. Copy to .env (git-ignored) and uncomment what you set, or export in the shell;
# the shell wins. Leave a line commented rather than empty: an empty VITE_MOON_TILES= turns the dev server's local tiles off.
# Vite reads VITE_* from .env into the app; vite.config.ts also reads MOON_* from it. Nothing here is needed for `npm run dev`:
# with no variables the viewer runs offline on the 4k base maps, with telemetry off.

# --- Data mirror ------------------------------------------------------------------------------------------------------------
# The public mirror of the hosted tile set (best effort, no SLA; NASA/USGS/JAXA tiers only). `npm run dev:hosted` uses it
# as MOON_REMOTE_BASE; to use another mirror, export MOON_MIRROR in the shell (the npm script reads the shell, not .env).
# MOON_MIRROR=https://storage.googleapis.com/skylumi-moon-serve-b7f804/moon/

# --- Dev server (vite.config.ts) --------------------------------------------------------------------------------------------
# Local data folders served at /moon/tiles, /moon/patch, /moon/mid-patch and /moon/internal (all git-ignored).
# MOON_TILES_DIR=.tiles
# MOON_PATCH_DIR=.patch
# MOON_MID_PATCH_DIR=.mid-patch
# Restricted-licence coverage rows; local only, never redirected and never in a build.
# MOON_INTERNAL_DIR=.internal
# A file missing on disk under /moon/tiles, /moon/patch or /moon/mid-patch is redirected to this hosted base (ending in /moon/).
# It also sets the dev server's Terrain Camera layer to <base>tc/v3/ when VITE_MOON_TC is unset. Empty = 404, layer off.
# MOON_REMOTE_BASE=
# Older, narrower redirects: missing tiles only (MOON_TILES_REMOTE, a tiles base), or deep levels only (MOON_DEEP_REDIRECT).
# MOON_TILES_REMOTE=
# MOON_DEEP_REDIRECT=

# --- Build: data bases baked into the bundle ---------------------------------------------------------------------------------
# Absolute URLs, or paths on the page's origin. Empty = that layer is off (the dev server uses /moon/tiles/ etc. instead).
# To point a build at the public mirror: VITE_MOON_TILES=${MOON_MIRROR}tiles/ and so on.
# VITE_MOON_TILES=
# VITE_MOON_PATCH=
# VITE_MOON_MID_PATCH=
# SELENE Terrain Camera detail (credit: ISAS/JAXA (modified)), e.g. <mirror>tc/v3/.
# VITE_MOON_TC=
# Baked terrain-shadow tables, e.g. <mirror>horizons/baked-a/.
# VITE_MOON_HORIZONS=
# Comma-separated bases a visitor's ?tiles=, ?patch=, ?midpatch=, ?horizons= or ?tc= override may name, besides loopback and the
# build's own bases (src/moon/dataBase.ts). Empty = none.
# VITE_MOON_DATA_ORIGINS=

# --- Build: telemetry --------------------------------------------------------------------------------------------------------
# Public client keys. No key = no telemetry, no SDK in the bundle and no Sentry or PostHog host in the page's CSP.
# The CSP's connect-src gets the hosts of whichever keys are set (src/build/indexHtml.ts). Visitors opt out with ?telemetry=0.
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when a PostHog key is set.
# VITE_POSTHOG_HOST=
# hidden = write source maps without a sourceMappingURL comment (for an error-tracker upload; never serve them). Empty = no maps.
# MOON_SOURCEMAP=

# --- Build: native shell --------------------------------------------------------------------------------------------------------
# true = the Capacitor shell's build (skylumi-labs/3d-moon-native sets it).
# VITE_NATIVE_BUILD=

# --- Tests and tools ----------------------------------------------------------------------------------------------------------
# Optional local data that turns on the data-dependent tests (`MOON_TILES_DIR=$PWD/.tiles npm test`) and the two standalone checks.
# MOON_WIDE_HEIGHT_DIR=
# MOON_MID_SAMPLE_DIR=
# The audit's browser binary and extra Chrome flags (audit/lib.mts).
# MOON_AUDIT_CHROME=
# MOON_AUDIT_CHROME_ARGS=
# Where the publish scripts read the telemetry key files (a local folder outside the repo).
# MOON_SECRETS_DIR=
