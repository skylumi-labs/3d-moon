import assert from 'node:assert/strict'
import { readFileSync } from 'node:fs'

// The toolbar after the owner's review: Home (not Reset), no About, no Stars, no Alps ridge button; those moved into Credits, the debug sheet and the viewpoint list.
const read = (p: string): string => readFileSync(new URL(`../${p}`, import.meta.url), 'utf8')
const bar = read('src/ui/bar.ts')
const main = read('src/main.ts')
assert.match(bar, /id: 'home', label: 'Home', ariaLabel: 'Home'/, 'the reset button is called Home')
assert.doesNotMatch(bar, /id: 'about'/, 'no About button')
assert.match(bar, /\[\.\.\.items\.values\(\)\]\.sort\(\(a, b\) => a\.item\.order - b\.item\.order\)/, 'bar buttons are placed in their visual order, so the Tab order is the order on screen (Home, Labels, Time, More)')
// Owner review 2026-10-23, #12 (bar clutter): no Share button; Quality, Relief and Credits are in the More sheet at every width, not only on a phone; while manual
// navigation is on (no viewpoint, or moved off one) the navigator tells the bar (setCompact), which keeps the pad's toggle in More and tells the pad (barmanual).
assert.doesNotMatch(bar, /id: 'share'|clipboard|bar-toast/, 'no Share button and no copy handler in the bar')
assert.doesNotMatch(bar, /max-width: 520px|narrow\.matches/, 'overflow items no longer depend on a phone width')
assert.match(bar, /if \(item\.id === 'more' \|\| !item\.overflow && !moved\)/, 'overflow items are in More at every width')
for (const [file, id] of [['src/ui/quality.ts', 'quality'], ['src/ui/topography.ts', 'topography'], ['src/main.ts', 'credits']]) assert.match(read(file), new RegExp(`id: '${id}'[^}]*overflow: true`), `${id} is a More item`)
assert.match(main, /id: 'credits', label: 'Credits'[^}]*onClick: \(\) => document\.querySelector<HTMLButtonElement>\('#credit \.credit-link'\)\?\.click\(\)/, 'Credits in More presses the brand line\'s own link')
assert.match(bar, /const placeToggle = [\s\S]*const target = manual \|\| flying \? more : icons/, 'the pad\'s toggle is in More while manual navigation is on or a flight\'s slider holds the row')
assert.match(bar, /setCompact\(on\) \{ if \(manual !== on\) \{ manual = on; place\(\); bar\.dispatchEvent\(new CustomEvent\('barmanual', \{ detail: on \}\)\) \} \}/)
assert.match(read('src/ui/navigator.ts'), /bar\.setCompact\(!state\.pos\)/, 'the row does not compact or move its controls when the visitor drags away')
assert.doesNotMatch(bar, /shareUrl/, 'the bar no longer asks main.ts for the link; shareUrl stays in main.ts for the native shell and the S key')
// Folding (owner decision 2026-10-24): the pad never folds anything into More; only a flight's slider does (flightCompactLevel, fed the bar's real width less the pad when it stands in the row on a wide screen); the classes go on first so the width read is the 52 rem one.
assert.match(bar, /bar\.classList\.toggle\('padrow', padInRow\)\n\s+bar\.classList\.toggle\('flying', flying\)\n\s+bar\.classList\.toggle\('compact', manual\)\n\s+const room = bar\.getBoundingClientRect\(\)\.width \|\| Infinity/)
assert.match(bar, /const level = barCompactLevel\(window\.innerWidth, room, flying, padInRow, backReserved\)/)
assert.match(bar, /const moved = level === 2 \|\| \(level === 1 && item\.id !== 'home'\)/, 'level 2 folds every item but More (and the toggle, which follows manual navigation)')
assert.match(bar, /window\.addEventListener\('resize', \(\) => \{ if \(flying\) place\(\) \}\)/, 'a resize mid-flight re-places')
assert.match(main, /^function shareUrl\(\): string/m)
// #5: no caption before a viewpoint; the list button is the way to the list then.
assert.match(read('src/ui/navigator.ts'), /const hideCaption = !state\.pos \|\| state\.away/, 'the caption is hidden before a viewpoint and cleared while away')
assert.match(read('src/ui/navigator.css'), /\.nav-caption\[hidden\] \{ display: none; \}/)
assert.doesNotMatch(read('src/viewpointList.ts'), /places and flights/, 'no "9 places and flights" line')
assert.doesNotMatch(bar, /bar-about/, 'no About dialog')
assert.doesNotMatch(main, /bar.addItem\(\{ id: 'ridge'/, 'no Alps ridge button')
assert.match(read('src/viewpointList.ts'), /id: 'alps-ridge', name: 'The Moon behind a ridge'/, 'the Alps ridge entry is kept in viewpointList.ts')
assert.match(read('src/viewpointList.ts'), /HIDDEN_ENTRIES[^\n]*= \[\n\s*\{ id: 'alps-ridge'/, 'and hidden from the visitor list (it can return; ?start=ridge still opens it)')
assert.doesNotMatch(read('src/ui/pins.ts'), /id: 'viewpoints'/, 'the Viewpoints button left the bar: the navigator pill replaces it')
assert.match(read('src/ui/navigator.ts'), /bar\.navSlot\.append\(pill\)/, 'the navigator buttons are items of the bar\'s one row')
assert.match(read('src/ui/bar.ts'), /bar\.append\(navSlot, padSlot, icons\)/, 'the bar has no divider that separates the navigation and action buttons into clusters')
assert.doesNotMatch(read('src/ui/bar.ts'), /class: 'bar-sep'/, 'the bar row has no visual divider between clusters')
assert.match(read('src/ui/bar.css'), /\.bar-icons \{ display: contents; \}/, 'action buttons share the row layout with the navigation buttons')
assert.match(read('src/ui/bar.css'), /\.bar, \.bar-padrow \{[^}]*justify-content: space-evenly;/, 'buttons spread evenly across the full bar width')
assert.match(read('src/ui/navigator.ts'), /dock\.insertBefore\(caption, barEl\)/, 'the viewpoint caption stands right over the row')
assert.match(main, /mountNavigator\(/, 'the pill is mounted with the bar')
assert.doesNotMatch(read('src/ui/quality.ts'), /goto-terminator|goto-a17/, 'the Quality sheet no longer carries the Go to buttons')
assert.match(main, /action: 'goto-terminator'/, 'the test views live in the debug sheet')
// Time sheet: three days either way in 15 minute ticks, two rows, no foot row.
assert.match(bar, /export const DAY_SPAN_MIN = 3 \* 24 \* 60/, 'the Day range is 3 days either way')
assert.match(bar, /DAY_STEP_MIN = 15/, '15 minute ticks')
assert.doesNotMatch(bar, /bar-sheet-foot|12 hours either way/, 'the foot row and the 12 hour note are gone')
assert.doesNotMatch(read('src/ui/bar.css'), /bar-sheet-foot/, 'no foot row in the CSS')
assert.match(bar, /head\.append\(when, nowBtn, seg\)/, 'row 1: the moment, Now, the range switch')
assert.match(bar, /Time, 3 days either way/, 'the range is in the slider\'s name')
// Icons only on the bar; the word is the name and the tooltip, and shows in the More sheet.
assert.match(bar, /class="lbl"/, 'the label is kept for More and the accessible name')
assert.match(read('src/ui/bar.css'), /\.bar button \.lbl \{ display: none; \}/, 'no words on the bar')
assert.match(bar, /not-live/, 'a clock off Now tints the Time icon')
assert.doesNotMatch(read('src/ui/bar.css'), /not-live span/, 'the blue date label is gone')
// Return is an icon in the row.
assert.doesNotMatch(read('src/ui/navigator.css'), /flex: 1 0 100%/, 'Return no longer takes a line of its own')
assert.match(read('src/ui/navigator.ts'), /tablerIcon\('arrowBackUp'/, 'Return is the back-arrow icon')
assert.match(read('src/ui/navigator.ts'), /returnB\.classList\.toggle\('available', v\.canReturn\)/, 'Back joins the picker after moving off')
assert.match(read('src/ui/navigator.ts'), /sliderSlot\.append\(stopB\)/, 'Stop sits with the moment slider in the bar')
assert.match(read('src/ui/navigator.ts'), /stopB\.hidden = current\?\.kind !== 'moment'/, 'Stop is shown for a selected moment')
assert.match(read('src/ui/tours.ts'), /stop: halt/, 'the bar Stop control uses the existing in-place moment halt')
// The flight's row: pause, slider, next; no readout.
assert.match(read('src/ui/navigator.css'), /\.js-read \{ display: none; \}/, 'no time readout in the row')
const hud = read('src/hud.ts')
assert.match(hud, /ABOUT_PARAGRAPHS/, 'the About text is in the Credits panel')
assert.match(hud, /brandText\.textContent = `\$\{BRAND_LINE\} \(`/, 'the brand line ("<BRAND_LINE> (Credits)", src/branding.ts; scripts/branding.test.mts checks the text)')
console.log('ui-toolbar: ok')
